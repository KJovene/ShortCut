<!DOCTYPE html>
{#
 # La proposition en PDF (#213), rendue par Dompdf : CSS 2.1, tableaux plutôt que flexbox, polices DejaVu (accents
 # et « € »). Couleurs du site : terre #C2471E, encre #2B1D14, crème #FBF6EE, sable #F3E7D6, taupe #6E5A4B.
 #}
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Proposition {{ p.destination.ville ?? p.demande.lieuOuZone ?? 'de voyage' }} · version {{ p.version }}</title>
<style>
    @page { margin: 22mm 16mm 20mm 16mm; }
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 10pt; line-height: 1.45; color: #2B1D14; }
    h1, h2, h3 { font-family: 'DejaVu Serif', serif; font-weight: bold; color: #2B1D14; margin: 0; }
    h1 { font-size: 26pt; line-height: 1.1; margin: 6mm 0 2mm; }
    h2 { font-size: 15pt; margin: 8mm 0 3mm; padding-bottom: 1.5mm; border-bottom: 1.5px solid #E3CDB0; }
    h3 { font-size: 11pt; margin: 0 0 1mm; }
    p { margin: 0 0 2mm; }
    .discret { color: #6E5A4B; }
    .petit { font-size: 8.5pt; }
    .surtitre { font-size: 8.5pt; font-weight: bold; letter-spacing: 1.2px; text-transform: uppercase; color: #9A3A18; }
    .saut { page-break-before: always; }
    .insecable { page-break-inside: avoid; }

    /* En-tête et pied répétés sur chaque page */
    #entete { position: fixed; top: -15mm; left: 0; right: 0; height: 10mm; border-bottom: 1px solid #EADBC6; }
    #entete img { width: 7mm; height: 7mm; vertical-align: middle; }
    #entete .marque { font-family: 'DejaVu Serif', serif; font-size: 12pt; font-weight: bold; vertical-align: middle; margin-left: 2mm; }
    #entete .droite { position: absolute; right: 0; top: 2mm; font-size: 8pt; color: #6E5A4B; }
    #pied { position: fixed; bottom: -13mm; left: 0; right: 0; height: 9mm; border-top: 1px solid #EADBC6; padding-top: 2mm; font-size: 7pt; color: #6E5A4B; }

    /* Statut, visible en première page */
    .statut { margin: 4mm 0; padding: 3.5mm 4.5mm; border-radius: 3mm; font-weight: bold; }
    .statut--estimee { background: #FFF4D6; border: 1px solid #F0DCA0; color: #5C4300; }
    .statut--confirmee { background: #DDF1E4; border: 1px solid #B9E0C6; color: #1F6B3A; }
    .statut .etiquette { display: inline-block; padding: 0.8mm 2.5mm; border-radius: 2mm; font-size: 8pt; letter-spacing: 0.8px; text-transform: uppercase; color: #FFFFFF; margin-right: 2mm; }
    .statut--estimee .etiquette { background: #9A6B00; }
    .statut--confirmee .etiquette { background: #1F6B3A; }

    .couverture-photo { width: 100%; height: 78mm; border-radius: 4mm; }
    table.chiffres { width: 100%; border-collapse: separate; border-spacing: 2.5mm 0; margin: 4mm -2.5mm 0; }
    table.chiffres td { background: #FBF6EE; border: 1px solid #EADBC6; border-radius: 2.5mm; padding: 2.5mm 3.5mm; width: 25%; vertical-align: top; }
    table.chiffres .valeur { font-family: 'DejaVu Serif', serif; font-size: 10.5pt; font-weight: bold; }
    .total { margin-top: 5mm; padding: 4mm 5mm; background: #3A2418; color: #FBF6EE; border-radius: 4mm; }
    .total .montant { font-family: 'DejaVu Serif', serif; font-size: 22pt; font-weight: bold; }
    .total .discret { color: #F3E7D6; }

    table.programme { width: 100%; border-collapse: collapse; }
    table.programme td { padding: 2.5mm 2mm; border-bottom: 1px solid #F3E7D6; vertical-align: top; }
    table.programme .jour { width: 24mm; color: #C2471E; font-family: 'DejaVu Serif', serif; font-weight: bold; }
    table.programme .jour span { display: block; font-family: 'DejaVu Sans', sans-serif; font-weight: normal; font-size: 8pt; color: #6E5A4B; }

    table.prestation { width: 100%; border-collapse: collapse; margin-bottom: 3mm; background: #FBF6EE; border-radius: 3mm; }
    table.prestation td { padding: 3mm; vertical-align: top; }
    table.prestation .photo { width: 42mm; padding-right: 0; }
    table.prestation img { width: 42mm; height: 28mm; border-radius: 2mm; }
    ul { margin: 0; padding-left: 4.5mm; }
    li { margin-bottom: 0.8mm; }

    table.niveaux { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    table.niveaux th, table.niveaux td { padding: 2.5mm; border: 1px solid #EADBC6; text-align: left; }
    table.niveaux th { background: #F3E7D6; font-size: 8.5pt; }
    table.niveaux .retenu { background: #FBEDE6; font-weight: bold; }
    .droite { text-align: right; }
</style>
</head>
<body>
    <div id="entete">
        <img src="{{ logo }}" alt=""><span class="marque">Détour</span>
        <span class="droite">Proposition · version {{ p.version }}{{ confirmee ? ' · confirmée' : ' · prix estimés' }}</span>
    </div>
    <div id="pied">
        Détour, agence de voyages sur mesure · 12 rue des Voyageurs, 75000 Paris · conseillers du lundi au vendredi de 9 h à 18 h 30.<br>
        {{ confirmee ? 'Prix vérifiés par votre conseiller auprès des prestataires.' : p.mention }} Rien n’est réservé ni payé avant votre accord.
    </div>

    {# Couverture #}
    <p class="surtitre">
        {{ type ?? 'Votre voyage' }} · version {{ p.version }} du {{ (confirmee and p.confirmeeLe ? p.confirmeeLe : p.creeLe)|date_longue }}
    </p>
    <h1>{{ p.destination.ville ?? p.demande.lieuOuZone ?? 'Votre voyage' }}{% if p.programme is not empty %}, {{ p.programme|length }} jours{% endif %}</h1>
    {% if client %}<p class="discret">Préparée pour {{ client }}</p>{% endif %}

    <div class="statut statut--{{ p.etat }}">
        <span class="etiquette">{{ confirmee ? 'Proposition confirmée' : 'Proposition estimée' }}</span>
        {% if confirmee %}
            Confirmée par votre conseiller le {{ p.confirmeeLe|date_longue }} : prix vérifiés auprès des prestataires.
        {% else %}
            {{ p.mention }} Confirmation annoncée sous 2 jours ouvrés.
        {% endif %}
    </div>

    {% if photoDestination %}
        <img class="couverture-photo" src="{{ photoDestination }}" alt="">
    {% endif %}

    <table class="chiffres">
        <tr>
            <td><span class="petit discret">Départ</span><br><span class="valeur">{{ p.demande.dateDebut ? p.demande.dateDebut|date_longue : 'À préciser' }}</span></td>
            <td><span class="petit discret">Retour</span><br><span class="valeur">{{ p.demande.dateFin ? p.demande.dateFin|date_longue : 'À préciser' }}</span></td>
            <td><span class="petit discret">Voyageurs</span><br><span class="valeur">{{ p.demande.adultes }} adulte{{ p.demande.adultes > 1 ? 's' }}{% if p.demande.enfants %}, {{ p.demande.enfants }} enfant{{ p.demande.enfants > 1 ? 's' }}{% endif %}</span></td>
            <td><span class="petit discret">Niveau</span><br><span class="valeur">{{ niveaux[p.niveauBudget] }}</span></td>
        </tr>
    </table>

    {% if p.pourquoi %}<p style="margin-top: 5mm; font-size: 11pt;">{{ p.pourquoi }}</p>{% endif %}

    <div class="total insecable">
        <span class="petit discret">{{ confirmee ? 'Votre budget confirmé' : 'Votre budget estimé' }}, niveau {{ niveaux[p.niveauBudget]|lower }}</span><br>
        <span class="montant">{{ p.totalCentimes|euros }}</span><br>
        <span class="discret">soit {{ p.totalParPersonneCentimes|euros }} par personne, frais de dossier de {{ p.fraisDeDossierCentimes|euros }} inclus</span>
    </div>

    {# Programme #}
    {% if p.programme is not empty %}
        <h2 class="saut">Programme jour par jour</h2>
        <table class="programme">
            {% for j in p.programme %}
                <tr class="insecable">
                    <td class="jour">J{{ j.jour }}<span>{{ j.date|date_jour }}</span></td>
                    <td><h3>{{ j.titre }}</h3><span class="discret">{{ j.description }}</span></td>
                </tr>
            {% endfor %}
        </table>
    {% endif %}

    {# Hébergements et activités #}
    {% for type, titre in {logement: 'Hébergement', activite: 'Activités incluses'} %}
        {% set liste = p.prestations|filter(x => x.type == type) %}
        {% if liste is not empty %}
            {% for x in liste %}
                {# Le titre de la section reste avec sa première prestation, jamais seul en bas de page. #}
                {% if loop.first %}<div class="insecable"><h2>{{ titre }}</h2>{% endif %}
                <table class="prestation insecable">
                    <tr>
                        {% if photos[x.id] ?? null %}<td class="photo"><img src="{{ photos[x.id] }}" alt=""></td>{% endif %}
                        <td>
                            <h3>{{ x.nom }}</h3>
                            {% if x.pointsForts is not empty %}
                                <ul>{% for point in x.pointsForts %}<li>{{ point }}</li>{% endfor %}</ul>
                            {% endif %}
                            <p class="petit discret" style="margin-top: 1.5mm;">
                                Niveau{{ x.niveaux|length > 1 ? 'x' }} : {{ x.niveaux|map(n => niveaux[n] ?? n)|join(', ') }}
                            </p>
                        </td>
                    </tr>
                </table>
                {% if loop.first %}</div>{% endif %}
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if p.argumentaire is not empty %}
        <div class="insecable">
        <h2>Pourquoi ce voyage vous correspond</h2>
        <ul>
            {% for a in p.argumentaire %}<li><strong>{{ a.exigence }}</strong> : {{ a.reponse }}</li>{% endfor %}
        </ul>
        </div>
    {% endif %}

    {# Budget #}
    <h2 class="saut">Votre budget</h2>
    <div class="statut statut--{{ p.etat }}">
        <span class="etiquette">{{ confirmee ? 'Prix confirmés' : 'Prix estimés' }}</span>
        {{ confirmee ? 'Prix vérifiés par votre conseiller auprès des prestataires.' : 'Estimés à partir des tarifs de l’agence, à confirmer par votre conseiller.' }}
    </div>
    <table class="niveaux">
        <tr><th>Niveau</th><th class="droite">Total</th><th class="droite">Par personne</th></tr>
        {% for niveau, libelle in niveaux %}
            {% if budgets[niveau] is defined %}
                <tr{% if niveau == p.niveauBudget %} class="retenu"{% endif %}>
                    <td>{{ libelle }}{% if niveau == p.niveauBudget %} (détaillé dans cette proposition){% endif %}</td>
                    <td class="droite">{{ budgets[niveau].totalCentimes|euros }}</td>
                    <td class="droite">{{ budgets[niveau].parPersonneCentimes|euros }}</td>
                </tr>
            {% endif %}
        {% endfor %}
    </table>
    <p class="petit discret">Totaux marge et frais de dossier compris ({{ p.fraisDeDossierCentimes|euros }}).</p>

    {% if p.lignes is not empty %}
        <h3 style="margin-top: 5mm;">Inclus dans le niveau {{ niveaux[p.niveauBudget]|lower }}</h3>
        <ul>
            {% for l in p.lignes %}<li>{{ l.libelle }}{% if l.quantite > 1 %} × {{ l.quantite }}{% endif %}</li>{% endfor %}
        </ul>
    {% endif %}

    {% if p.hypotheses is not empty %}
        <h3 style="margin-top: 5mm;">Hypothèses de budget</h3>
        <ul class="discret">
            {% for h in p.hypotheses %}<li>{{ h }}</li>{% endfor %}
        </ul>
    {% endif %}

    <p style="margin-top: 8mm;">
        {% if p.statut == 'acceptee' %}
            Vous avez accepté cette proposition : votre conseiller réserve votre voyage.
        {% elseif confirmee %}
            Pour l’accepter, rendez-vous sur votre page « Ma proposition ». Rien n’est réservé avant votre accord.
        {% else %}
            Pour la faire confirmer, rendez-vous sur votre page « Ma proposition » : votre conseiller vérifie prix et disponibilités sous 2 jours ouvrés.
        {% endif %}
    </p>
</body>
</html>
