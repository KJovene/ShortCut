{% extends 'base.html.twig' %}

{% block title %}Période - {{ destination.ville }}{% endblock %}

{% block body %}
    <main>
        <h1>Saisir une période pour {{ destination.ville }}</h1>
        {% for message in app.flashes('success') %}
            <p role="status">{{ message }}</p>
        {% endfor %}
        {{ form_start(form) }}
            {{ form_row(form.debut) }}
            {{ form_row(form.fin) }}
            {{ form_row(form.temperatureMoyenne) }}
            {{ form_row(form.pluieMm) }}
            <h2>Tarifs des prestations</h2>
            {% for tarifForm in form.tarifs %}
                <fieldset>
                    <legend>{{ tarifForm.vars.data.prestation.nom|default('Prestation') }}</legend>
                    {{ form_widget(tarifForm) }}
                </fieldset>
            {% endfor %}
            <button type="submit">Enregistrer la période</button>
            {% if form.vars.value.id %}
                <button type="submit" name="{{ form.vars.name }}_duplicate">Dupliquer la période précédente</button>
            {% endif %}
        {{ form_end(form) }}

        <h2>Périodes à compléter dans les 12 prochains mois</h2>
        {% if periodes_non_couvertes is empty %}
            <p>Aucune période à compléter.</p>
        {% else %}
            <ul>
                {% for periode in periodes_non_couvertes %}
                    <li>{{ periode.debut|date('d/m/Y') }} - {{ periode.fin|date('d/m/Y') }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
