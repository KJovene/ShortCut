{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title 'Températures - ' ~ destination.ville %}
{% block content_title %}Températures de {{ destination.ville }}{% endblock %}

{% block main %}
    <a href="{{ path('admin_climat') }}" class="btn btn-secondary mb-3">Retour aux destinations</a>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <p class="bo-intro">Température moyenne en °C. Les champs laissés vides conservent leur valeur actuelle.</p>
    {{ form_start(form) }}
        <div class="row">
            {% for field in form %}
                <div class="col-md-3 col-sm-4 mb-3">
                    {{ form_row(field) }}
                </div>
            {% endfor %}
        </div>
        <button class="btn btn-primary" type="submit">Enregistrer les températures</button>
    {{ form_end(form) }}
{% endblock %}
