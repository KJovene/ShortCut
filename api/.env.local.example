# Copier en .env.local (jamais commité) puis renseigner les valeurs.
# Seules les variables à surcharger sont nécessaires : les autres viennent de .env.

# Clé API Claude personnelle, créée dans la console Claude.
ANTHROPIC_API_KEY=

# À décommenter si votre PostgreSQL local n'utilise pas les identifiants par défaut.
# DATABASE_URL="postgresql://shortcut:shortcut@127.0.0.1:5432/shortcut?serverVersion=16&charset=utf8"
